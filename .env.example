# SEC EDGAR requires a User-Agent with a name and contact email on every request.
SEC_USER_AGENT="stock-agent your.email@example.com"

# Google AI Studio API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Telegram delivery: create a bot via @BotFather, then get your chat id from
# @userinfobot (or getUpdates after messaging your bot once).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Neon Postgres (free tier) — durable state for cloud runs. Optional locally:
# without it, state lives in out/state/*.json files only.
DATABASE_URL=""
